# Frontend values: safe to expose in the browser.
VITE_API_BASE_URL=http://localhost:5080/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
VITE_SUPABASE_USERNAME_DOMAIN=users.adiel.local

# API-only values: do not commit your completed .env.docker file.
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=your-session-pooler-host;Port=5432;Database=postgres;Username=postgres.your-project-ref;Password=your-database-password;SSL Mode=Require;Trust Server Certificate=true
ACCESSCONTROL__OWNERUSERID=your-supabase-auth-user-uuid
SUPABASE__URL=https://your-project.supabase.co
SUPABASE__STORAGE__SERVICEROLEKEY=your-server-only-supabase-secret-key
