# Frontend values: safe to expose in the browser.
VITE_API_BASE_URL=http://localhost:5080/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
VITE_SUPABASE_USERNAME_DOMAIN=users.adiel.local

# API-only values: do not commit your completed .env.docker file.
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=your-session-pooler-host;Port=5432;Database=postgres;Username=postgres.your-project-ref;Password=your-database-password;SSL Mode=Require;Trust Server Certificate=true
ACCESSCONTROL__OWNERUSERID=your-supabase-auth-user-uuid
SUPABASE__URL=https://your-project.supabase.co
SUPABASE__STORAGE__SERVICEROLEKEY=your-server-only-supabase-secret-key

# Google Calendar OAuth: create a Web application client in Google Cloud.
# Register GOOGLECALENDAR__REDIRECTURI exactly as an authorized redirect URI.
GOOGLECALENDAR__ENABLED=true
GOOGLECALENDAR__CLIENTID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLECALENDAR__CLIENTSECRET=your-google-oauth-client-secret
GOOGLECALENDAR__REDIRECTURI=http://localhost:5080/api/v1/integrations/google-calendar/callback
GOOGLECALENDAR__FRONTENDREDIRECTURI=http://localhost:5173/settings?section=calendar
GOOGLECALENDAR__FRONTENDBASEURI=http://localhost:5173/
GOOGLECALENDAR__CALENDARID=primary
GOOGLECALENDAR__TIMEZONE=Asia/Singapore
GOOGLECALENDAR__EVENTDURATIONMINUTES=60
